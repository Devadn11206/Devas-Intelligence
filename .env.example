# Environment Configuration for DEVA INTELLIGENCE
APP_NAME="DEVA INTELLIGENCE"
ENVIRONMENT=development
DEBUG=True
TESTING=False

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://deva_user:deva_password@postgres:5432/deva_db
DATABASE_POOL_SIZE=10

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MLflow Tracking
MLFLOW_TRACKING_URI=http://mlflow:5000

# LLM Configuration (OpenAI Compatible or Mock)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=mock-api-key
LLM_MODEL_PRIMARY=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini

# Embeddings & Reranking
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
